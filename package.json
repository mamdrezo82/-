{
  "name": "roozyar-personal-planner",
  "version": "1.6.0",
  "private": true,
  "description": "Persian personal planner with analytics, global search, customizable cards, offline storage and reminders",
  "scripts": {
    "start": "npx serve www",
    "build": "esbuild native-plugins-entry.js --bundle --format=iife --outfile=www/native-plugins.bundle.js",
    "android:add": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "assets:generate": "npx capacitor-assets generate --android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.0.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/local-notifications": "^7.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "serve": "^14.2.4",
    "esbuild": "^0.25.0",
    "@capacitor/assets": "^3.0.5"
  }
}
